<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassicUO.Ecs\ClassicUO.Ecs.csproj" />
  </ItemGroup>

  <!-- Staged guest components for the tinyecs:modding modding tests. Sourced from
       the per-mod folders; flattened to the output root, where BuildAppWith reads
       them and synthesizes the <mod>/{mod.wasm,mod.json} layout the loader scans. -->
  <ItemGroup>
    <None Include="..\..\ecs-mods\topbar\mod.wasm" Link="ecs_topbar.wasm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ecs-mods\netlog\mod.wasm" Link="ecs_netlog.wasm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ecs-mods\status\mod.wasm" Link="ecs_status.wasm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ecs-mods\ui\mod.wasm" Link="ecs_ui.wasm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
