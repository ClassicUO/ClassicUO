{
  "_comment": "Scenario: login screen -> log in -> open paperdoll -> walk 4 steps west. Coordinates are client-area pixels at the default ClassicUO windowed resolution; tune for your build by running `agent-desktop shot --pid <pid> --out ./calibrate.png` and reading off positions in an image viewer.",
  "_calibration": {
    "loginButton":   { "x": 555, "y": 470 },
    "charSelectNext":{ "x": 610, "y": 445 },
    "cameraCenter":  { "x": 400, "y": 300 },
    "walkWestPoint": { "x": 120, "y": 300 }
  },
  "steps": [
    { "op": "sleep", "ms": 3000 },
    { "op": "shot",  "name": "login-screen" },

    { "op": "click", "x": 555, "y": 470, "button": "left" },
    { "op": "sleep", "ms": 5000 },
    { "op": "shot",  "name": "post-login" },

    { "op": "click", "x": 610, "y": 445, "button": "left" },
    { "op": "sleep", "ms": 6000 },
    { "op": "shot",  "name": "in-world" },

    { "op": "double-click", "x": 400, "y": 300, "button": "left" },
    { "op": "sleep", "ms": 1500 },
    { "op": "shot",  "name": "paperdoll-open" },

    { "op": "move",    "x": 120, "y": 300 },
    { "op": "hold",    "x": 120, "y": 300, "button": "right" },
    { "op": "sleep",   "ms": 2200 },
    { "op": "release", "x": 120, "y": 300, "button": "right" },
    { "op": "sleep",   "ms": 700 },
    { "op": "shot",    "name": "walked-4-west" }
  ]
}
