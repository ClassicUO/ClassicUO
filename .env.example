# agent-desktop harness config. Copy to .env (gitignored) and fill in.
# `agent-desktop up` patches client version + UO data dir into settings.json;
# `smoke` and `${VAR}` tokens in `script --file` pull the login credentials.

UO_CLIENT_VERSION=7.0.115.0
UO_DIRECTORY=C:\path\to\UltimaOnline
UO_USERNAME=admin
UO_PASSWORD=admin
