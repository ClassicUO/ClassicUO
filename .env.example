# agent-desktop harness config. Copy to .env (gitignored) and fill in.
# `agent-desktop up` patches client version + UO data dir into settings.json
# and (if MODERNUO_PATH is set) launches the ModernUO server;
# `smoke` and `${VAR}` tokens in `script --file` pull the login credentials.

UO_CLIENT_VERSION=7.0.115.0
UO_DIRECTORY=C:\path\to\UltimaOnline
UO_USERNAME=admin
UO_PASSWORD=admin

# ModernUO server. Path to ModernUO.exe (or the distribution dir containing
# it). When set, `up` launches the server and `down`/Ctrl-C kills it.
# Leave unset to manage the server yourself.
MODERNUO_PATH=C:\path\to\ModernUO\Distribution
