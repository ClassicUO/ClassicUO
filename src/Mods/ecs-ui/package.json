{
  "name": "@classicuo/ecs-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "types": "jco guest-types wit -o generated",
    "bundle": "node esbuild.mjs",
    "componentize": "jco componentize dist/index.js --wit wit --world-name ecs-ui --disable http --disable fetch-event --out dist/ecs_ui.wasm",
    "build": "npm run bundle && npm run componentize"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-reconciler": "^0.32.0",
    "ts-pattern": "^5.7.1"
  },
  "devDependencies": {
    "@bytecodealliance/componentize-js": "^0.18.4",
    "@bytecodealliance/jco": "^1.11.1",
    "@types/react": "^19.1.8",
    "@types/react-reconciler": "^0.32.0",
    "esbuild": "^0.25.8",
    "type-fest": "^4.41.0",
    "typescript": "^5.8.3"
  }
}
