<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>cuoicon.ico</ApplicationIcon>
    <AssemblyName>cuo-ecs</AssemblyName>
    <RootNamespace>ClassicUO</RootNamespace>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClassicUO.Ecs.Tests" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>$(ProjectDir)..\..\bin\Release\</OutputPath>
    <PublishDir>$(ProjectDir)..\..\bin\dist\</PublishDir>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>$(ProjectDir)..\..\bin\Debug\</OutputPath>
    <DefineConstants>$(DefineConstants)TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Agent dev-loop flavor (opt-in via -p:AGENT_BUILD=true). Enables the
       JSON-RPC AgentServerPlugin gated by #if AGENT_BUILD (Boot.cs + Agent/).
       Unlike the legacy client this keeps the cuo-ecs assembly name + output
       path; launch bin/Debug/net10.0/cuo-ecs.dll directly for the harness. -->
  <PropertyGroup Condition="'$(AGENT_BUILD)' == 'true'">
    <DefineConstants>$(DefineConstants);AGENT_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Resources\ResErrorMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResErrorMessages.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResGeneral.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResGeneral.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\ResGumps.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ResGumps.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ResErrorMessages.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ResGeneral.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResGeneral.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ResGumps.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ResGumps.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\FNA\FNA.Core.csproj" />
    <ProjectReference Include="..\..\external\TinyEcs\src\TinyEcs.Bevy\TinyEcs.Bevy.csproj" />
    <ProjectReference Include="..\..\external\TinyEcs\src\TinyEcs.Bevy.UI\TinyEcs.Bevy.UI.csproj" />
    <ProjectReference Include="..\..\external\TinyEcs\src\TinyEcs.Bevy.Input\TinyEcs.Bevy.Input.csproj" />
    <ProjectReference Include="..\..\external\TinyEcs\src\TinyEcs\TinyEcs.csproj" />
    <ProjectReference Include="..\ClassicUO.Assets\ClassicUO.Assets.csproj" />
    <ProjectReference Include="..\ClassicUO.Renderer\ClassicUO.Renderer.csproj" />
    <ProjectReference Include="..\ClassicUO.Schema\ClassicUO.Schema.csproj" />
    <ProjectReference Include="..\ClassicUO.Utility\ClassicUO.Utility.csproj" />
    <ProjectReference Include="..\ClassicUO.Agent.Contracts\ClassicUO.Agent.Contracts.csproj" Condition="'$(AGENT_BUILD)' == 'true'" />
    <ProjectReference Include="..\ClassicUO.Agent.Host\ClassicUO.Agent.Host.csproj" Condition="'$(AGENT_BUILD)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="cuoapi">
      <HintPath>..\..\external\cuoapi\cuoapi.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Extism.runtime.all" Version="1.12.0" />
    <PackageReference Include="Extism.Sdk" Version="1.9.1" />
  </ItemGroup>

  <!-- NEW component-model modding API (tinyecs:modding WIT). Uses the local
       wasmtime-dotnet fork (component-model host + WIT source generator). The
       generator emits Wit.Tinyecs.Modding.* host bindings from the .wit AdditionalFile.
       Independent of the Extism API above. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\wasmtime-dotnet\src\Wasmtime\Wasmtime.csproj" />
    <ProjectReference Include="..\..\..\..\wasmtime-dotnet\src\Wasmtime.SourceGenerator\Wasmtime.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- One package per directory: the WIT source generator drops ALL packages
         in a directory that holds more than one (WSGEN001), so each package's
         .wit lives in its own folder. -->
    <AdditionalFiles Include="EcsModding\wit\tinyecs\tinyecs.wit" />
    <AdditionalFiles Include="EcsModding\wit\cuo\cuo-modding.wit" />
    <!-- Deploy built mod components next to the exe (output/ecs-mods/). -->
    <None Include="..\..\ecs-mods\*.wasm" Link="ecs-mods\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native wasmtime.dll is a NuGet-style runtime asset of the fork; it
       does NOT flow reliably through a ProjectReference. Copy it explicitly
       from the fork's net9.0 output (the TFM cuo-ecs consumes) so new Engine()
       can P/Invoke it. Windows x64 only for now. -->
  <ItemGroup>
    <_WasmtimeNative Include="..\..\..\..\wasmtime-dotnet\src\Wasmtime\bin\$(Configuration)\net9.0\wasmtime.dll" />
  </ItemGroup>
  <Target Name="CopyWasmtimeNative_build" AfterTargets="Build" Condition="'$(_IsWindows)' == 'true'">
    <Copy SourceFiles="@(_WasmtimeNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('@(_WasmtimeNative)')" />
  </Target>
  <Target Name="CopyWasmtimeNative_publish" AfterTargets="Publish" Condition="'$(_IsWindows)' == 'true'">
    <Copy SourceFiles="@(_WasmtimeNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('@(_WasmtimeNative)')" />
  </Target>

  <PropertyGroup>
    <_IsWindows Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">true</_IsWindows>
    <_IsMacOS Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</_IsMacOS>
    <_IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</_IsLinux>
  </PropertyGroup>

  <ItemGroup>
    <DataFiles_x64 Include="$(ProjectDir)..\..\external\x64\*.*" />
    <DataFiles_lib64 Include="$(ProjectDir)..\..\external\lib64\*.*" />
    <DataFiles_osx Include="$(ProjectDir)..\..\external\osx\*.*" />
    <DataFiles_vulkan Include="$(ProjectDir)..\..\external\vulkan\icd.d\*.*" />
  </ItemGroup>

  <Target Name="CopyExternalDeps_build" AfterTargets="Build">
    <Copy SourceFiles="@(DataFiles_x64)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'$(_IsWindows)' == 'true'" />
    <Copy SourceFiles="@(DataFiles_lib64)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'$(_IsLinux)' == 'true'" />
    <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'$(_IsMacOS)' == 'true'" />
    <Copy SourceFiles="@(DataFiles_vulkan)" DestinationFolder="$(OutputPath)\vulkan\icd.d\" SkipUnchangedFiles="true" Condition="'$(_IsMacOS)' == 'true'" />
  </Target>

  <Target Name="CopyExternalDeps_publish" AfterTargets="Publish">
    <Copy SourceFiles="@(DataFiles_x64)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(_IsWindows)' == 'true'" />
    <Copy SourceFiles="@(DataFiles_lib64)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(_IsLinux)' == 'true'" />
    <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(_IsMacOS)' == 'true'" />
    <Copy SourceFiles="@(DataFiles_vulkan)" DestinationFolder="$(PublishDir)\vulkan\icd.d\" SkipUnchangedFiles="true" Condition="'$(_IsMacOS)' == 'true'" />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)..\..\ClassicUO.Agent.Settings.props" Condition="Exists('$(MSBuildThisFileDirectory)..\..\ClassicUO.Agent.Settings.props')" />

</Project>
